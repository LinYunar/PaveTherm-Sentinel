# 用户备份: 包含用户原始含真 key 的 config.yaml 备份,绝对不能 commit
config.yaml.user

# 用户专属监测点数据 (含个人路面/坐标信息,绝对不能 commit)
# ⚠️ 这是个人敏感数据,跟 key 同等级保护
data/monitoring_points.yaml

# 用户专属 key 文件 (在 ~/.hermes/secrets/, 这里是 belt-and-suspenders 兜底)
.env
*.key
*.secret
secrets/

# Python 缓存
__pycache__/
*.pyc
*.pyo

# 测试临时
.pytest_cache/
tests/__pycache__/

# 导出文件 (含用户监测点数据)
exports/

# 备份文件 (任何 .bak/.backup)
*.bak
*.backup

# 可能的 csv / html 临时
*.tmp

# ❗ 不 ignore config.yaml —— 它现在是占位符版 (含 ${env:...} 占位符), 应被 commit 让别人能装
# ❗ 不 ignore config.yaml.template — 同样应被 commit 作为示例
